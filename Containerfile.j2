# k9s — FreeBSD daemonless image
# The Kubernetes terminal UI, with kubectl beside it, from FreeBSD packages.
# Upstream: https://github.com/derailed/k9s (Apache-2.0)

ARG BASE_TAG=15-pkg

FROM ghcr.io/daemonless/base-core:${BASE_TAG}
ARG FREEBSD_ARCH=amd64
ARG PKG_NAME="k9s"
ARG PACKAGES="k9s kubectl"

LABEL org.opencontainers.image.title="k9s" \
      org.opencontainers.image.description="k9s, the Kubernetes terminal UI, with kubectl, on FreeBSD" \
      org.opencontainers.image.source="https://github.com/daemonless/k9s" \
      org.opencontainers.image.url="https://github.com/derailed/k9s" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.vendor="daemonless" \
      org.opencontainers.image.authors="daemonless" \
      io.daemonless.category="Utilities" \
      io.daemonless.pkg-name="${PKG_NAME}" \
      io.daemonless.packages="${PACKAGES}" \
      io.daemonless.arch="${FREEBSD_ARCH}"

RUN pkg update && pkg install -y ${PACKAGES} \
    && mkdir -p /app \
    && pkg query '%v' ${PKG_NAME} > /app/version \
    && chmod -R a+rX /app \
    && pkg clean -ay && rm -rf /var/cache/pkg/*

# /config holds k9s's own settings, skins and logs; the kubeconfig is
# mounted read-only at /kubeconfig (KUBECONFIG points there).
RUN mkdir -p /config && chown bsd:bsd /config
ENV HOME=/config \
    XDG_CONFIG_HOME=/config \
    XDG_DATA_HOME=/config \
    XDG_STATE_HOME=/config \
    KUBECONFIG=/kubeconfig
USER bsd
WORKDIR /config

ENTRYPOINT ["k9s"]
